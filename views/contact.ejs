<% layout("layouts/boilerplate") %>
<main class="contact-page">

    <section class="contact-hero">

        <p class="contact-label">
            KINGSMAN ESPORTS
        </p>

        <h1>
            Contact <span>&</span> Support
        </h1>

        <p class="contact-intro">
            Have a question, issue, or something you want
            to discuss with the KingsMan team?
            We're here to help.
        </p>

    </section>


    <section class="contact-content">

        <div class="container">

            <div class="row g-4">

                <!-- SUPPORT INFORMATION -->

                <div class="col-lg-5">

                    <div class="support-info">

                        <p class="section-label">
                            SUPPORT
                        </p>

                        <h2>
                            How can we help?
                        </h2>

                        <p class="support-text">
                            Whether you're having an issue with
                            your account, need help with the
                            Players Den, or want to get in touch
                            with KingsMan Esports, send us a message.
                        </p>


                        <div class="support-item">

                            <div class="support-number">
                                01
                            </div>

                            <div>
                                <h3>
                                    Account Support
                                </h3>

                                <p>
                                    Problems with your account,
                                    login, or registration.
                                </p>
                            </div>

                        </div>


                        <div class="support-item">

                            <div class="support-number">
                                02
                            </div>

                            <div>
                                <h3>
                                    Player Support
                                </h3>

                                <p>
                                    Questions regarding players,
                                    profiles, or verification.
                                </p>
                            </div>

                        </div>


                        <div class="support-item">

                            <div class="support-number">
                                03
                            </div>

                            <div>
                                <h3>
                                    General Enquiries
                                </h3>

                                <p>
                                    Partnerships, esports,
                                    collaborations, and other enquiries.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- CONTACT FORM -->

                <div class="col-lg-7">

                    <div class="contact-card">

                        <div class="contact-card-header">

                            <h2>
                                Send us a message
                            </h2>

                            <p>
                                Fill out the form and our team
                                will get back to you.
                            </p>

                        </div>


                        <% if (typeof success !=='undefined' && success) { %>

                            <div class="alert alert-success">
                                Your message has been sent successfully.
                            </div>

                            <% } %>


                                <% if (typeof error !=='undefined' && error) { %>

                                    <div class="alert alert-danger">
                                        <%= error %>
                                    </div>

                                    <% } %>


                                        <form action="/contact" method="POST">

                                            <!-- NAME -->

                                            <div class="form-group">

                                                <label for="name">
                                                    Name
                                                </label>

                                                <input type="text" id="name" name="name" placeholder="Your name"
                                                    required>

                                            </div>


                                            <!-- EMAIL -->

                                            <div class="form-group">

                                                <label for="email">
                                                    Email
                                                </label>

                                                <input type="email" id="email" name="email" placeholder="your@email.com"
                                                    required>

                                            </div>


                                            <!-- SUBJECT -->

                                            <div class="form-group">

                                                <label for="subject">
                                                    Subject
                                                </label>

                                                <select id="subject" name="subject" required>

                                                    <option value="">
                                                        Select a subject
                                                    </option>

                                                    <option value="Account Support">
                                                        Account Support
                                                    </option>

                                                    <option value="Player Support">
                                                        Player Support
                                                    </option>

                                                    <option value="Player Verification">
                                                        Player Verification
                                                    </option>

                                                    <option value="Partnership">
                                                        Partnership
                                                    </option>

                                                    <option value="General Enquiry">
                                                        General Enquiry
                                                    </option>

                                                </select>

                                            </div>


                                            <!-- MESSAGE -->

                                            <div class="form-group">

                                                <label for="message">
                                                    Message
                                                </label>

                                                <textarea id="message" name="message" rows="6"
                                                    placeholder="Tell us how we can help..." required></textarea>

                                            </div>


                                            <!-- SUBMIT -->

                                            <button type="submit" class="contact-submit">

                                                Send Message

                                            </button>

                                        </form>

                    </div>

                </div>

            </div>

        </div>

    </section>

</main>