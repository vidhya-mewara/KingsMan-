<% layout("layouts/boilerplate") %>

    <div class="tm-page tm-show-page">

        <!-- TOP BAR -->
        <div class="tm-show-topbar">

            <a href="/tournament-events" class="tm-back-button">
                <span>←</span>
                BACK TO EVENTS
            </a>

            <span class="tm-event-code">
                KM // <%= String(event._id).slice(-6).toUpperCase() %>
            </span>

        </div>


        <!-- HERO -->
        <section class="tm-event-detail-hero">

            <% if (event.logo) { %>

                <img class="tm-detail-background" src="<%= event.logo %>" alt="">

                <% } %>

                    <div class="tm-detail-overlay"></div>

                    <div class="tm-detail-grid"></div>


                    <div class="tm-detail-content">

                        <div class="tm-detail-status">

                            <% if (event.status==="ongoing" ) { %>

                                <span class="tm-card-status live">
                                    <i></i>
                                    LIVE NOW
                                </span>

                                <% } else if (event.status==="upcoming" ) { %>

                                    <span class="tm-card-status upcoming">
                                        UPCOMING
                                    </span>

                                    <% } else { %>

                                        <span class="tm-card-status completed">
                                            COMPLETED
                                        </span>

                                        <% } %>

                        </div>


                        <span class="tm-detail-kicker">
                            KINGSMAN TOURNAMENT SERIES
                        </span>


                        <h1>
                            <%= event.name %>
                        </h1>


                        <div class="tm-detail-line"></div>


                        <p class="tm-detail-description">
                            Competitive esports tournament hosted by KingsMan.
                            Enter the battlefield, compete with the best and
                            make your mark.
                        </p>

                    </div>

        </section>


        <!-- EVENT INFORMATION -->
        <section class="tm-information-section">

            <div class="tm-section-heading">

                <div>
                    <span class="tm-section-number">
                        01 // DETAILS
                    </span>

                    <h2>
                        EVENT INFORMATION
                    </h2>
                </div>

            </div>


            <div class="tm-information-grid">

                <!-- START -->
                <div class="tm-information-item">

                    <span class="tm-information-label">
                        START
                    </span>

                    <strong>
                        <%= new Date(event.startDate).toLocaleDateString("en-IN", { day: "2-digit" , month: "short" ,
                            year: "numeric" }) %>
                    </strong>

                    <small>
                        EVENT START DATE
                    </small>

                </div>


                <!-- END -->
                <div class="tm-information-item">

                    <span class="tm-information-label">
                        END
                    </span>

                    <strong>
                        <%= new Date(event.endDate).toLocaleDateString("en-IN", { day: "2-digit" , month: "short" ,
                            year: "numeric" }) %>
                    </strong>

                    <small>
                        EVENT END DATE
                    </small>

                </div>


                <!-- PRIZE -->
                <div class="tm-information-item tm-prize-item">

                    <span class="tm-information-label">
                        PRIZE POOL
                    </span>

                    <strong>
                        ₹<%= Number(event.prizeAmount || 0).toLocaleString("en-IN") %>
                    </strong>

                    <small>
                        TOTAL PRIZE
                    </small>

                </div>


                <!-- MODE -->
                <div class="tm-information-item">

                    <span class="tm-information-label">
                        MODE
                    </span>

                    <strong>
                        <%= event.mode || "—" %>
                    </strong>

                    <small>
                        COMPETITION FORMAT
                    </small>

                </div>

            </div>

        </section>


        <!-- STATUS -->
        <section class="tm-status-section">

            <div class="tm-status-panel">

                <div class="tm-status-left">

                    <span class="tm-section-number">
                        02 // STATUS
                    </span>

                    <% if (event.status==="ongoing" ) { %>

                        <h2>
                            MATCHES ARE LIVE
                        </h2>

                        <p>
                            The competition is currently underway.
                            Stay locked in.
                        </p>

                        <% } else if (event.status==="upcoming" ) { %>

                            <h2>
                                GET READY
                            </h2>

                            <p>
                                This tournament is coming soon.
                                Prepare your squad.
                            </p>

                            <% } else { %>

                                <h2>
                                    EVENT COMPLETE
                                </h2>

                                <p>
                                    This tournament has finished.
                                    Check back for future competitions.
                                </p>

                                <% } %>

                </div>


                <div class="tm-status-mark">
                    KM
                </div>

            </div>

        </section>


        <!-- BOTTOM NAVIGATION -->
        <div class="tm-show-navigation">

            <a href="/tournament-events" class="tm-large-action">
                <span>←</span>
                ALL TOURNAMENT EVENTS
            </a>

        </div>

    </div>