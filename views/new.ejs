<!-- Social Media -->

<div class="mb-4 text-start">

    <h5 class="mb-3">Social Media</h5>

    <!-- Instagram -->
    <div class="mb-3">
        <label for="instagram" class="form-label">
            Instagram
        </label>

        <input type="text" class="form-control kingsman-input" id="instagram" name="socialMedia[instagram]"
            placeholder="Enter Instagram username">

        <div class="form-text">
            Enter your username only, without @
        </div>
    </div>


    <!-- Facebook -->
    <div class="mb-3">
        <label for="facebook" class="form-label">
            Facebook
        </label>

        <input type="text" class="form-control kingsman-input" id="facebook" name="socialMedia[facebook]"
            placeholder="Enter Facebook username">
    </div>


    <!-- YouTube -->
    <div class="mb-3">
        <label for="youtube" class="form-label">
            YouTube
        </label>

        <input type="text" class="form-control kingsman-input" id="youtube" name="socialMedia[youtube]"
            placeholder="Enter YouTube username">

        <div class="form-text">
            Enter your channel username without @
        </div>
    </div>


    <!-- Twitch -->
    <div class="mb-3">
        <label for="twitch" class="form-label">
            Twitch
        </label>

        <input type="text" class="form-control kingsman-input" id="twitch" name="socialMedia[twitch]"
            placeholder="Enter Twitch username">
    </div>


    <!-- Kick -->
    <div class="mb-3">
        <label for="kick" class="form-label">
            Kick
        </label>

        <input type="text" class="form-control kingsman-input" id="kick" name="socialMedia[kick]"
            placeholder="Enter Kick username">
    </div>

</div>


                            <!-- Verification Screenshot -->

