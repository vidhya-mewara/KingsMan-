<% layout("/layouts/boilerplate") %>

    <div class="player-form-page">

        <div class="container py-5">

            <div class="text-center mb-5">
                <h1 class="roster-title">
                    Join <span class="text-accent">KingsMan</span>
                </h1>

                <p class="roster-subtitle">
                    Register yourself as a player
                </p>

                <div class="roster-divider"></div>
            </div>


            <div class="row justify-content-center">

                <div class="col-12 col-md-8 col-lg-6">

                    <div class="profile-card player-form-card">

                        <form action="/players" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>

                            <!-- Name -->

                            <div class="mb-4 text-start">

                                <label for="name" class="form-label">
                                    Full Name
                                </label>

                                <input type="text" class="form-control kingsman-input" id="name" name="name"
                                    placeholder="Enter your full name" maxlength="50" required>
                                    <div class="invalid-feedback">
                                        Player name is required and must be at least 2 characters.
                                    </div>


                            </div>


                            <!-- IGN -->

                            <div class="mb-4 text-start">

                                <label for="ign" class="form-label">
                                    In-Game Name
                                </label>

                                <input type="text" class="form-control kingsman-input" id="ign" name="ign"
                                    placeholder="Your Valorant IGN" maxlength="30" required>
                                    <div class="invalid-feedback">
                                        Player In Game Name is required.
                                    </div>

                            </div>


                            <!-- UID -->

                            <div class="mb-4 text-start">

                                <label for="uid" class="form-label">
                                    Valorant UID
                                </label>

                                <input type="text" class="form-control kingsman-input" id="uid" name="uid"
                                    placeholder="Example: 100001" required>

                                <div class="form-text">
                                    Enter your unique Valorant player UID.
                                </div>
                                <div class="invalid-feedback">
                                    Player UID is required.
                                </div>

                            </div>


                            <!-- Roles -->

                            <div class="mb-4 text-start">

                                <label class="form-label">
                                    Select Your Roles
                                </label>

                                <div class="role-selection">

                                    <label class="role-option">
                                        <input type="checkbox" name="role" value="Duelist">
                                        <span>Duelist</span>
                                    </label>


                                    <label class="role-option">
                                        <input type="checkbox" name="role" value="Initiator">
                                        <span>Initiator</span>
                                    </label>


                                    <label class="role-option">
                                        <input type="checkbox" name="role" value="Controller">
                                        <span>Controller</span>
                                    </label>


                                    <label class="role-option">
                                        <input type="checkbox" name="role" value="Sentinel">
                                        <span>Sentinel</span>
                                    </label>


                                    <label class="role-option">
                                        <input type="checkbox" name="role" value="Flex">
                                        <span>Flex</span>
                                    </label>

                                </div>

                            </div>
                            <!-- agent  -->
                            <div class="form-group">
                                <label class="form-label">Select Your Agents</label>
                            
                                <div class="agent-selection">
                            
                                    <% const agentList=[ "Jett" , "Raze" , "Neon" , "Yoru" , "Iso" , "Phoenix" , "Reyna" , "Waylay" , "Sova"
                                        , "Fade" , "Breach" , "K/O" , "Tejo" , "Gekko" , "Skye" , "Brimstone" , "Omen" , "Harbour" , "Astra"
                                        , "Viper" , "Clove" , "Cypher" , "Killjoy" , "Chamber" , "Vyse" , "Deadlock" , "Sage" ]; %>
                            
                                        <% agentList.forEach(agent=> { %>
                            
                                            <label class="agent-option">
                                                <input type="checkbox" name="agents" value="<%= agent %>">
                            
                                                <span class="agent-name">
                                                    <%= agent %>
                                                </span>
                                            </label>
                            
                                            <% }) %>
                            
                                </div>
                            
                                <p class="form-help">
                                    Select all agents you are comfortable playing.
                                </p>
                            </div>
                            <!-- In Team -->
                            <div class="form-check form-switch mb-3">
                                <input class="form-check-input" type="checkbox" role="switch" id="inTeam" name="inTeam" value="true">
                            
                                <label class="form-check-label" for="inTeam">
                                    I am currently in a team
                                </label>
                            </div>
<!-- Team Name -->
<div class="mb-4 text-start" id="teamNameContainer" style="display: none;">
    <label for="teamName" class="form-label">Team Name</label>

    <input type="text" class="form-control kingsman-input" id="teamName" name="teamName"
        placeholder="Enter your team name" maxlength="50">

    <div class="invalid-feedback">
        Team name is required when you are in a team.
    </div>
</div>
                            <!-- Region -->
                            
                            <div class="mb-4 text-start">
                            
