                                </label>

                                <input type="file" class="form-control kingsman-input" id="verificationScreenshot"
                                    name="verificationScreenshot" accept="image/png,image/jpeg,image/webp" required>
                                    <div class="invalid-feedback">
                                        ID Screenshot is required.
                                    </div>

                                <div class="form-text">
                                    Upload a screenshot that proves your Valorant account/UID.
                                </div>

