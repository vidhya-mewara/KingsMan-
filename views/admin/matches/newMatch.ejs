<% layout("/layouts/boilerplate") %>

    <div class="admin-match-page">

        <div class="admin-match-header">
            <h1>Add Match</h1>
            <p>Create a new match for the KingsMan website.</p>
        </div>


        <form action="/admin/matches" method="POST" class="admin-match-form">

            <!-- ============================= -->
            <!-- SERIES -->
            <!-- ============================= -->

            <div class="form-group">

                <label for="seriesName">
                    Series / Tournament
                </label>

                <input type="text" id="seriesName" name="seriesName" maxlength="100" required
                    placeholder="KingsMan Invitational - Semi Final">

            </div>


            <!-- ============================= -->
            <!-- TEAMS -->
            <!-- ============================= -->

            <div class="form-row">

                <div class="form-group">

                    <label for="teamA">
                        Team A
                    </label>

                    <input type="text" id="teamA" name="teamA" maxlength="50" required placeholder="KingsMan">

                </div>


                <div class="form-group">

                    <label for="teamB">
                        Team B
                    </label>

                    <input type="text" id="teamB" name="teamB" maxlength="50" required placeholder="Phoenix">

                </div>

            </div>


        
        <!-- ============================= -->
        <!-- DATE & TIME -->
        <!-- ============================= -->
        
        <div class="form-group match-datetime-group">
        
            <label class="form-section-label">
                Match Date & Time
            </label>
        
            <div class="datetime-row">
        
                <!-- DATE -->
                <div class="datetime-field">
        
                    <label for="matchDate">
                        Match Date
                    </label>
        
                    <div class="datetime-input-wrapper">
                        <span class="datetime-icon">📅</span>
        
                        <input type="date" id="matchDate" name="matchDate" required>
                    </div>
        
                </div>
        
                <!-- time -->
                <div class="datetime-field">
                    <label for="matchTime">Match Time</label>
                
                    <div class="datetime-input-wrapper">
                        <span class="datetime-icon">🕐</span>
                
                        <input type="time" id="matchTime" name="matchTime" required>
                    </div>
                </div>
        
            </div>
        
            <small class="datetime-help">
                Select the date and starting time for the match.
            </small>
        
        </div>
        



            <!-- ============================= -->
            <!-- STATUS -->
            <!-- ============================= -->

            <div class="form-group">

                <label for="status">
                    Match Status
                </label>

                <select id="status" name="status" required>

                    <option value="upcoming">
                        Upcoming
                    </option>

                    <option value="ongoing">
                        Ongoing
                    </option>

                    <option value="past">
                        Past
                    </option>

                </select>

            </div>


            <!-- ============================= -->
            <!-- SCORE -->
            <!-- ============================= -->

            <div class="form-row">

                <div class="form-group">

                    <label for="teamAScore">
                        Team A Score
                    </label>

                    <input type="number" id="teamAScore" name="teamAScore" min="0" value="0" required>

                </div>


                <div class="form-group">

                    <label for="teamBScore">
                        Team B Score
                    </label>

                    <input type="number" id="teamBScore" name="teamBScore" min="0" value="0" required>

                </div>

            </div>

            <!-- ============================= -->
            <!-- PLAYER STATISTICS -->
            <!-- ============================= -->
            
            <section class="player-stats-section">
            
                <div class="player-stats-header">
            
                    <div>
                        <span class="player-stats-kicker">
                            MATCH DATA // PLAYER PERFORMANCE
                        </span>
            
                        <h2>Player Statistics</h2>
            
                        <p>
                            Search for a verified player by IGN and enter their match statistics.
                        </p>
                    </div>
            
                    <div class="player-stats-count">
                        10 PLAYER SLOTS
                    </div>
            
                </div>
            
            
                <div class="player-stats-table">
            
                    <!-- TABLE HEADER -->
            
                    <div class="player-stat-row player-stat-header">
            
                        <div class="player-stat-field player-column-player">
                            <label>Player</label>
                        </div>
            
                        <div class="player-stat-field player-column-team">
                            <label>Team</label>
                        </div>
            
                        <div class="player-stat-field player-column-stat">
                            <label>K</label>
                        </div>
            
                        <div class="player-stat-field player-column-stat">
                            <label>D</label>
                        </div>
            
                        <div class="player-stat-field player-column-stat">
                            <label>A</label>
                        </div>
            
                        <div class="player-stat-field player-column-mvp">
                            <label>MVP</label>
                        </div>
            
                    </div>
            
            
                    <!-- PLAYER ROWS -->
            
                    <% for (let i=0; i < 10; i++) { %>
            
                        <div class="player-stat-row">
            
                            <!-- PLAYER -->
            
                            <div class="player-stat-field player-search-field">
                            
                                <input type="text" name="players[<%= i %>][playerName]" class="player-search-input" list="verified-players"
                                    placeholder="Search IGN..." autocomplete="off">
                            
                                <input type="hidden" name="players[<%= i %>][player]" class="player-id-input">
                            
                            </div>
            
                            <datalist id="verified-players">
                            
                                <% (players || []).forEach(function(player) { %>
                            
                                    <option value="<%= player.ign %>">
                                        <%= player.name %>
                                    </option>
                            
                                    <% }) %>
                            
                            </datalist>
            
                            <!-- TEAM -->
            
                            <div class="player-stat-field player-column-team">
            
                                <select name="players[<%= i %>][team]">
            
                                    <option value="teamA">
                                        Team A
                                    </option>
            
                                    <option value="teamB">
                                        Team B
                                    </option>
            
                                </select>
            
                            </div>
            
            
                            <!-- KILLS -->
            
                            <div class="player-stat-field player-column-stat">
            
                                <input type="number" name="players[<%= i %>][kills]" min="0" value="0" aria-label="Kills">
            
                            </div>
            
            
                            <!-- DEATHS -->
            
                            <div class="player-stat-field player-column-stat">
            
                                <input type="number" name="players[<%= i %>][deaths]" min="0" value="0" aria-label="Deaths">
            
                            </div>
            
            
                            <!-- ASSISTS -->
            
                            <div class="player-stat-field player-column-stat">
            
                                <input type="number" name="players[<%= i %>][assists]" min="0" value="0" aria-label="Assists">
            
                            </div>
            
            
                            <!-- MVP -->
            
                            <div class="player-stat-field player-column-mvp">
            
                                <label class="mvp-checkbox">
            
                                    <input type="checkbox" name="players[<%= i %>][mvp]" value="true">
            
                                    <span></span>
            
                                </label>
            
                            </div>
            
                        </div>
            
                        <% } %>
            
                </div>
            
            </section>

            <!-- ============================= -->
            <!-- SUBMIT -->
            <!-- ============================= -->

            <button type="submit" class="admin-match-submit">
                Add Match
            </button>


            
        </form>
        
       <script>
        document.addEventListener("DOMContentLoaded", function () {

            const players = <%- JSON.stringify(players||[]) %>;

            const searchInputs = document.querySelectorAll(".player-search-input");

            searchInputs.forEach(function (input) {

                const row = input.closest(".player-stat-row");
                const hiddenInput = row.querySelector(".player-id-input");

                input.addEventListener("input", function () {

                    const value = input.value.trim().toLowerCase();

                    hiddenInput.value = "";

                    if (!value) {
                        return;
                    }

                    const player = players.find(function (p) {

                        return String(p.ign || "").toLowerCase() === value;

                    });

                    if (player) {

                        hiddenInput.value = player._id;

                        console.log(
                            "Selected player:",
                            player.ign,
                            player._id
                        );
                    }
                });

            });

        });
    </script>
    </div>