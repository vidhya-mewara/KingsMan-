<% layout("/layouts/boilerplate") %>
<section class="hero-slider">
    <div class="slider-container">

        <% sliders.forEach((slide, index)=> { %>
        
            <div class="slide <%= index === 0 ? 'active' : '' %>">
        
                <a href="/events/<%= slide._id %>">
        
                    <img src="<%= slide.image %>" alt="<%= slide.title %>">
        
                </a>
        
            </div>
        
            <% }) %>

                <% if (sliders.length> 1) { %>
                    <button class="slider-arrow prev" type="button">&#10094;</button>
                    <button class="slider-arrow next" type="button">&#10095;</button>

                    <div class="slider-dots">
                        <% sliders.forEach((slide, index)=> { %>
                            <button class="dot <%= index === 0 ? 'active' : '' %>" data-slide="<%= index %>"
                                type="button">
                            </button>
                            <% }) %>
                    </div>
                    <% } %>

    </div>
</section>
<!-- ============================= -->
<!-- PROMOTION SECTION -->
<!-- ============================= -->
<div class="home-main-grid">

<% if (promotions && promotions.length> 0) { %>

    <section class="promotion-wrapper">

        <div class="promotion-section">

            <div class="promotion-heading">
                <div>
                    <span class="promotion-kicker">KINGSMAN // FEATURED</span>
                    <h2>PROMOTIONS & SPONSORS</h2>
                </div>

                <span class="promotion-live">
                    <i></i>
                    FEATURED
                </span>
            </div>


            <div class="promotion-slider" id="promotionSlider">

                <% promotions.forEach((promotion, index)=> { %>

                    <article class="promotion-slide <%= index === 0 ? 'active' : '' %>" data-slide="<%= index %>">

                        <div class="promotion-image">

                            <img src="<%= promotion.image %>" alt="<%= promotion.title %>"
                                loading="<%= index === 0 ? 'eager' : 'lazy' %>">

                            <div class="promotion-image-overlay"></div>

                        </div>


                        <div class="promotion-content">

                            <span class="promotion-label">
                                SPONSORED / FEATURED
                            </span>

                            <h3>
                                <%= promotion.title %>
                            </h3>

                            <% if (promotion.description) { %>

                                <p>
                                    <%= promotion.description %>
                                </p>

                                <% } %>


                                    <div class="promotion-links">

                                        <% if (promotion.websiteLink) { %>

                                            <a href="<%= promotion.websiteLink %>" target="_blank"
                                                rel="noopener noreferrer" class="promotion-social website">
                                                <span>↗</span>
                                                Website
                                            </a>

                                            <% } %>


                                                <% if (promotion.youtubeLink) { %>

                                                    <a href="<%= promotion.youtubeLink %>" target="_blank"
                                                        rel="noopener noreferrer" class="promotion-social youtube">
                                                        <span>▶</span>
                                                        YouTube
                                                    </a>

                                                    <% } %>


                                                        <% if (promotion.instagramLink) { %>

                                                            <a href="<%= promotion.instagramLink %>" target="_blank"
                                                                rel="noopener noreferrer"
                                                                class="promotion-social instagram">
                                                                <span>◎</span>
                                                                Instagram
                                                            </a>

                                                            <% } %>


                                                                <% if (promotion.discordLink) { %>

                                                                    <a href="<%= promotion.discordLink %>"
                                                                        target="_blank" rel="noopener noreferrer"
                                                                        class="promotion-social discord">
                                                                        <span>💬</span>
                                                                        Discord
                                                                    </a>

                                                                    <% } %>

                                    </div>

                        </div>

                    </article>

                    <% }) %>

            </div>


            <% if (promotions.length> 1) { %>

                <button type="button" class="promotion-arrow promotion-prev" aria-label="Previous promotion">
                    ‹
                </button>

                <button type="button" class="promotion-arrow promotion-next" aria-label="Next promotion">
                    ›
                </button>


                <div class="promotion-dots">

                    <% promotions.forEach((promotion, index)=> { %>

                        <button type="button" class="promotion-dot <%= index === 0 ? 'active' : '' %>"
                            data-slide="<%= index %>" aria-label="Go to promotion <%= index + 1 %>"></button>

                        <% }) %>

                </div>

                <% } %>

        </div>

    </section>

    <% } %>
    <!-- ============================= -->
    <!-- MATCHES SECTION -->
    <!-- ============================= -->
    
    
    <!-- ============================= -->
    <!-- MATCHES SECTION -->
    <!-- ============================= -->
    
    <section class="matches-wrapper">
    
        <div class="matches-section">
    
            <!-- HEADER -->
    
            <div class="matches-header">
    
                <h2>Matches</h2>
    
                
    
            </div>
    
    
            <!-- ================= -->
            <!-- ONGOING MATCHES -->
            <!-- ================= -->
    
            <% if (ongoingMatches && ongoingMatches.length> 0) { %>
    
                <div class="match-category">
    
                    <h3>Ongoing</h3>
    
                    <div class="matches-list">
    
                        <% ongoingMatches.slice(0, 2).forEach(match=> { %>
    
                            <a href="/matches/<%= match._id %>" class="match-card">
    
                                <div class="match-card-top">
    
                                    <div class="match-series">
                                        <%= match.seriesName %>
                                    </div>
    
                                    <div class="match-status ongoing">
                                        LIVE
                                    </div>
    
                                </div>
    
    
                                <div class="match-teams">
    
                                    <span class="team-name">
                                        <%= match.teamA %>
                                    </span>
    
                                    <span class="vs">
                                        VS
                                    </span>
    
                                    <span class="team-name">
                                        <%= match.teamB %>
                                    </span>
    
                                </div>
    
    
                               
    
                            </a>
    
                            <% }) %>
    
                    </div>
    
                </div>
    
                <% } %>
    
    
    
                    <!-- ================= -->
                    <!-- UPCOMING MATCHES -->
                    <!-- ================= -->
    
                    <% if (upcomingMatches && upcomingMatches.length> 0) { %>
    
                        <div class="match-category">
    
                            <h3>Upcoming</h3>
    
                            <div class="matches-list">
    
                                <% upcomingMatches.slice(0, 2).forEach(match=> { %>
    
                                    <a href="/matches/<%= match._id %>" class="match-card">
    
                                        <div class="match-card-top">
    
                                            <div class="match-series">
                                                <%= match.seriesName %>
                                            </div>
    
                                            <div class="match-status upcoming">
                                                NEXT
                                            </div>
    
                                        </div>
    
    
                                        <div class="match-teams">
    
                                            <span class="team-name">
                                                <%= match.teamA %>
                                            </span>
    
                                            <span class="vs">
                                                VS
                                            </span>
    
                                            <span class="team-name">
                                                <%= match.teamB %>
                                            </span>
    
                                        </div>
    
    
                                        <div class="match-date">
    
                                            <%= new Date(match.date).toLocaleDateString("en-IN", { day: "2-digit" ,
                                                month: "short" }) %>
    
                                                <span>•</span>
    
                                                <%= new Date(match.date).toLocaleTimeString([], { hour: "2-digit" ,
                                                    minute: "2-digit" }) %>
    
                                        </div>
    
                                    </a>
    
                                    <% }) %>
    
                            </div>
    
                        </div>
    
                        <% } %>
    
    
    
                            <!-- ================= -->
                            <!-- PAST MATCHES -->
                            <!-- ================= -->
    
                            <% if (pastMatches && pastMatches.length> 0) { %>
    
                                <div class="match-category">
    
                                    <h3>Completed</h3>
    
                                    <div class="matches-list">
    
                                        <% pastMatches.slice(0, 2).forEach(match=> { %>
    
                                            <a href="/matches/<%= match._id %>" class="match-card">
    
                                                <div class="match-card-top">
    
                                                    <div class="match-series">
                                                        <%= match.seriesName %>
                                                    </div>
    
                                                    <div class="match-status past">
                                                        DONE
                                                    </div>
    
                                                </div>
    
    
                                                <div class="match-teams">
    
                                                    <span class="team-name">
                                                        <%= match.teamA %>
                                                    </span>
    
                                                    <span class="vs">
                                                        VS
                                                    </span>
    
                                                    <span class="team-name">
                                                        <%= match.teamB %>
                                                    </span>
    
                                                </div>
    
    
                                               
    
    
                                                <div class="match-date">
    
                                                    <%= new Date(match.date).toLocaleDateString("en-IN", { day: "2-digit" ,
                                                        month: "short" }) %>
    
                                                </div>
    
                                            </a>
    
                                            <% }) %>
    
                                    </div>
    
                                </div>
    
                                <% } %>
    
    
    
                                    <!-- ================= -->
                                    <!-- NO MATCHES -->
                                    <!-- ================= -->
    
                                    <% if ( (!ongoingMatches || ongoingMatches.length===0) && (!upcomingMatches ||
                                        upcomingMatches.length===0) && (!pastMatches || pastMatches.length===0) ) { %>
    
                                        <div class="no-matches">
                                            No matches available.
                                        </div>
    
                                        <% } %>
    
    
                                            <!-- VIEW ALL -->
    
                                            <a href="/matches" class="matches-view-all-bottom">
                                                VIEW ALL MATCHES →
                                            </a>
    
        </div>
    
    </section>
    

    <!-- ============================= -->
    <!-- EVENTS SECTION -->
    <!-- ============================= -->
    
    <section class="home-events-wrapper">
    
        <div class="home-events-section">
    
            <div class="home-events-header">
                <h2>Events</h2>
            </div>
    
    
            <!-- ONGOING EVENTS -->
    
            <% if (ongoingEvents && ongoingEvents.length> 0) { %>
    
                <div class="home-event-category">
    
                    <h3>Ongoing</h3>
    
                    <div class="home-events-list">
    
                        <% ongoingEvents.forEach(event=> { %>
    
                            <a href="/tournament-events/<%= event._id %>" class="home-event-card">
    
                                <div class="home-event-logo">
    
                                    <% if (event.logo) { %>
    
                                        <img src="<%= event.logo %>" alt="<%= event.name %>">
    
                                        <% } else { %>
    
                                            <span>KM</span>
    
                                            <% } %>
    
                                </div>
    
                                <div class="home-event-info">
    
                                    <strong>
                                        <%= event.name %>
                                    </strong>
    
                                    <span>
                                        <%= new Date(event.startDate).toLocaleDateString("en-IN", { day: "2-digit" ,
                                            month: "short" }) %>
                                            -
                                            <%= new Date(event.endDate).toLocaleDateString("en-IN", { day: "2-digit" ,
                                                month: "short" }) %>
                                    </span>
    
                                </div>
    
                                <span class="home-event-status live">
                                    LIVE
                                </span>
    
                            </a>
    
                            <% }) %>
    
                    </div>
    
                </div>
    
                <% } %>
    
    
                    <!-- UPCOMING EVENTS -->
    
                    <% if (upcomingEvents && upcomingEvents.length> 0) { %>
    
                        <div class="home-event-category">
    
                            <h3>Upcoming</h3>
    
                            <div class="home-events-list">
    
                                <% upcomingEvents.forEach(event=> { %>
    
                                    <a href="/tournament-events/<%= event._id %>" class="home-event-card">
    
                                        <div class="home-event-logo">
    
                                            <% if (event.logo) { %>
    
                                                <img src="<%= event.logo %>" alt="<%= event.name %>">
    
                                                <% } else { %>
    
                                                    <span>KM</span>
    
                                                    <% } %>
    
                                        </div>
    
                                        <div class="home-event-info">
    
                                            <strong>
                                                <%= event.name %>
                                            </strong>
    
                                            <span>
                                                <%= new Date(event.startDate).toLocaleDateString("en-IN", { day: "2-digit" ,
                                                    month: "short" }) %>
                                                    -
                                                    <%= new Date(event.endDate).toLocaleDateString("en-IN", { day: "2-digit"
                                                        , month: "short" }) %>
                                            </span>
    
                                        </div>
    
                                        <span class="home-event-status upcoming">
                                            NEXT
                                        </span>
    
                                    </a>
    
                                    <% }) %>
    
                            </div>
    
                        </div>
    
                        <% } %>
    
    
                            <!-- COMPLETED EVENTS -->
    
                            <% if (completedEvents && completedEvents.length> 0) { %>
    
                                <div class="home-event-category">
    
                                    <h3>Completed</h3>
    
                                    <div class="home-events-list">
    
                                        <% completedEvents.forEach(event=> { %>
    
                                            <a href="/tournament-events/<%= event._id %>" class="home-event-card">
    
                                                <div class="home-event-logo">
    
                                                    <% if (event.logo) { %>
    
                                                        <img src="<%= event.logo %>" alt="<%= event.name %>">
    
                                                        <% } else { %>
    
                                                            <span>KM</span>
    
                                                            <% } %>
    
                                                </div>
    
                                                <div class="home-event-info">
    
                                                    <strong>
                                                        <%= event.name %>
                                                    </strong>
    
                                                    <span>
                                                        <%= new Date(event.startDate).toLocaleDateString("en-IN", {
                                                            day: "2-digit" , month: "short" }) %>
                                                            -
                                                            <%= new Date(event.endDate).toLocaleDateString("en-IN", {
                                                                day: "2-digit" , month: "short" }) %>
                                                    </span>
    
                                                </div>
    
                                                <span class="home-event-status completed">
                                                    DONE
                                                </span>
    
                                            </a>
    
                                            <% }) %>
    
                                    </div>
    
                                </div>
    
                                <% } %>
    
    
                                    <a href="/tournament-events" class="home-events-all">
                                        VIEW ALL EVENTS →
                                    </a>
    
        </div>
    
    </section>
    
</div>

<script src="/js/home.js"></script>
<script src="/js/promotion-slider.js"></script>

