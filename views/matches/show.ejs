<% layout("/layouts/boilerplate") %>

    <div class="match-page">

        <!-- ========================= -->
        <!-- MATCH HEADER -->
        <!-- ========================= -->

        <section class="match-header-card">

            <div class="match-team team-a">
                <h2>
                    <%= match.teamA %>
                </h2>
            </div>

            <div class="match-center">

                <div class="match-status">
                    <%= match.status.toUpperCase() %>
                </div>

                <div class="match-score">
                    <span>
                        <%= match.teamAScore %>
                    </span>
                    <strong>VS</strong>
                    <span>
                        <%= match.teamBScore %>
                    </span>
                </div>

                <div class="match-date">
                    <%= new Date(match.date).toLocaleString() %>
                </div>

            </div>

            <div class="match-team team-b">
                <h2>
                    <%= match.teamB %>
                </h2>
            </div>

        </section>


        <!-- ========================= -->
        <!-- PLAYER STATISTICS -->
        <!-- ========================= -->
        <% if (match.status === "past") { %>
        <section class="match-stats-section">

            <div class="stats-title">
                <h2>Player Statistics</h2>
            </div>


            <div class="teams-stats">


                <!-- ================= -->
                <!-- TEAM A -->
                <!-- ================= -->

                <div class="team-stats team-a-stats">

                    <div class="stats-team-title">
                        <h3>
                            <%= match.teamA %>
                        </h3>
                    </div>

                    <% if (teamAPlayers.length> 0) { %>

                        <% teamAPlayers.forEach((entry)=> { %>

                            <div class="player-stat-card">

                                <div class="player-info">
                                    <strong>
                                        <%= entry.player.ign %>
                                    </strong>

                                    <span>
                                        <%= entry.player.name %>
                                    </span>
                                </div>

                                <div class="player-stats">

                                    <div>
                                        <span>K</span>
                                        <strong>
                                            <%= entry.kills %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>D</span>
                                        <strong>
                                            <%= entry.deaths %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>A</span>
                                        <strong>
                                            <%= entry.assists %>
                                        </strong>
                                    </div>

                                </div>

                                <% if (entry.mvp) { %>
                                    <div class="mvp-badge">
                                        MVP
                                    </div>
                                    <% } %>

                            </div>

                            <% }) %>

                                <% } else { %>

                                    <div class="no-players">
                                        No player statistics available.
                                    </div>

                                    <% } %>

                </div>


                <!-- ================= -->
                <!-- TEAM B -->
                <!-- ================= -->

                <div class="team-stats team-b-stats">

                    <div class="stats-team-title">
                        <h3>
                            <%= match.teamB %>
                        </h3>
                    </div>

                    <% if (teamBPlayers.length> 0) { %>

                        <% teamBPlayers.forEach((entry)=> { %>

                            <div class="player-stat-card">

                                <div class="player-info">
                                    <strong>
                                        <%= entry.player.ign %>
                                    </strong>

                                    <span>
                                        <%= entry.player.name %>
                                    </span>
                                </div>

                                <div class="player-stats">

                                    <div>
                                        <span>K</span>
                                        <strong>
                                            <%= entry.kills %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>D</span>
                                        <strong>
                                            <%= entry.deaths %>
                                        </strong>
                                    </div>

                                    <div>
                                        <span>A</span>
                                        <strong>
                                            <%= entry.assists %>
                                        </strong>
                                    </div>

                                </div>

                                <% if (entry.mvp) { %>
                                    <div class="mvp-badge">
                                        MVP
                                    </div>
                                    <% } %>

                            </div>

                            <% }) %>

                                <% } else { %>

                                    <div class="no-players">
                                        No player statistics available.
                                    </div>

                                    <% } %>

                </div>

            </div>
            

        </section>
        <% } %>
        
        <div class="match-back">
            <a href="/" class="back-home-btn">
                ← Back to Home
            </a>
        </div>
        <% if (currUser && currUser.role==="admin" ) { %>
            <div class="admin-match-actions">
        
                <a href="/admin/matches/<%= match._id %>/edit" class="admin-edit-btn">
                    Edit Match
                </a>
        
                <form action="/admin/matches/<%= match._id %>?_method=DELETE" method="POST"
                    onsubmit="return confirm('Are you sure you want to delete this match?');">
                    <button type="submit" class="admin-delete-btn">
                        Delete Match
                    </button>
                </form>
        
            </div>
            <% } %>
    </div>