
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>KingsMan - Login</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #111;
            color: #fff;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: #1c1c1c;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .logo {
            text-align: center;
            margin-bottom: 10px;
            font-size: 32px;
            font-weight: bold;
            letter-spacing: 3px;
        }

        .subtitle {
            text-align: center;
            color: #aaa;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        label {
            display: block;
            margin-bottom: 8px;
            font-size: 14px;
            color: #ddd;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #444;
            border-radius: 6px;
            background: #292929;
            color: white;
            font-size: 15px;
            outline: none;
        }

        input:focus {
            border-color: #fff;
        }

        input::placeholder {
            color: #777;
        }

        .login-btn {
            width: 100%;
            padding: 13px;
            border: none;
            border-radius: 6px;
            background: #fff;
            color: #111;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
        }

        .login-btn:hover {
            background: #ddd;
        }

        .register-link {
            text-align: center;
            margin-top: 25px;
            color: #aaa;
            font-size: 14px;
        }

        .register-link a {
            color: #fff;
            text-decoration: none;
            font-weight: bold;
        }

        .register-link a:hover {
            text-decoration: underline;
        }

        .message {
            padding: 10px;
            border-radius: 6px;
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
        }

        .error {
            background: #3a1c1c;
            color: #ff8a8a;
            border: 1px solid #6b2b2b;
        }

        .success {
            background: #1c3a25;
            color: #8affaa;
            border: 1px solid #2b6b3d;
        }

        .forgot-password {
            text-align: right;
            margin-top: -10px;
            margin-bottom: 20px;
        }

        .forgot-password a {
            color: #aaa;
            font-size: 13px;
            text-decoration: none;
        }

        .forgot-password a:hover {
            color: #fff;
        }
    </style>
</head>

<body>

    <div class="login-container">

        <div class="login-card">

            <div class="logo">
                KINGSMAN
            </div>

            <p class="subtitle">
                Welcome back
            </p>

            <% if (error && error.length> 0) { %>
                <div class="message error">
                    <%= error[0] %>
                </div>
                <% } %>

                    <% if (success && success.length> 0) { %>
                        <div class="message success">
                            <%= success[0] %>
                        </div>
                        <% } %>

                            <form action="/login" method="POST">

                                <div class="form-group">
                                    <label for="email">Email</label>

                                    <input type="email" id="email" name="email" placeholder="Enter your email" required
                                        autocomplete="email">
                                </div>

                                <div class="form-group">
                                    <label for="password">Password</label>

                                    <input type="password" id="password" name="password"
                                        placeholder="Enter your password" required autocomplete="current-password">
                                </div>

                                <div class="forgot-password">
                                    <a href="/register">
                                        Create an account
                                    </a>
                                </div>

                                <button type="submit" class="login-btn">
                                    Login
                                </button>

                            </form>

                            <div class="register-link">
                                Don't have an account?
                                <a href="/register">Register</a>
                            </div>

        </div>

    </div>

</body>

</html>
